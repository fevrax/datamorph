# Site AI: OpenAI-compatible API base URL (including /v1), HTTPS only.
# Read only by the Vite development server / Docker container, never use VITE_* for keys.
OPENAI_BASE_URL=https://api.ssooai.com/v1
# Fill in your key. Empty = site AI disabled.
OPENAI_API_KEY=

# Docker Compose host port
APP_PORT=3300
