{
  "name": "json-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "test:key-naming": "tsx src/utils/keyNamingConverter.test.ts",
    "test:encoding-converter": "tsx src/utils/encodingConverter.test.ts",
    "test:regressions": "node --import tsx --test src/utils/*.test.ts src/workers/*.test.ts src/services/*.test.ts src/components/monacoEditor/editorPerformance.test.ts .github/tests/*.test.mjs docker/*.test.mjs config/*.test.ts",
    "preview": "vite preview",
    "semantic-release": "semantic-release",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/validator": "^13.15.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "js-base64": "^3.7.8",
    "js-yaml": "^4.3.1",
    "json5": "^2.2.3",
    "jsonpath-rfc9535": "^1.3.0",
    "jsonrepair": "^3.14.0",
    "jsonwebtoken": "8.5.1",
    "localforage": "^1.10.0",
    "lossless-json": "^4.3.0",
    "lucide-react": "^0.556.0",
    "monaco-editor": "^0.52.2",
    "next-themes": "^0.4.6",
    "openai": "^4.104.0",
    "quicktype-core": "23.0.171",
    "radix-ui": "1.7.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^6.30.3",
    "react-syntax-highlighter": "^15.6.6",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "validator": "^13.15.35",
    "vanilla-jsoneditor-cn": "^3.12.2",
    "xml-js": "^1.6.11",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "8.5.1",
    "@types/node": "20.5.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-unused-imports": "4.1.4",
    "postcss": "8.4.38",
    "prettier": "3.3.3",
    "semantic-release": "^23.1.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "vite": "^5.4.21",
    "vite-plugin-monaco-editor-esm": "^2.0.2",
    "vite-plugin-node-polyfills": "^0.23.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-tsconfig-paths": "^4.3.2",
    "workbox-build": "7.4.1",
    "workbox-window": "^7.4.1"
  },
  "packageManager": "pnpm@9.12.2+sha512.22721b3a11f81661ae1ec68ce1a7b879425a1ca5b991c975b074ac220b187ce56c708fe5db69f4c962c989452eee76c82877f4ee80f474cebd61ee13461b6228",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "package.json",
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}
